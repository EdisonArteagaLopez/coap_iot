<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Servidor CoAP"
            android:textStyle="bold"
            android:textSize="20sp" />

        <EditText
            android:id="@+id/etServerHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ex.: 192.168.1.10"
            android:text="192.168.1.10" />

        <Button
            android:id="@+id/btnDiscover"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Descobrir recursos" />

        <View
            android:layout_width="match_parent"
            android:layout_height="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sensores"
            android:textStyle="bold"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnCpu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ler CPU" />

        <Button
            android:id="@+id/btnMemory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ler memória" />

        <Button
            android:id="@+id/btnDisk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ler disco" />

        <Button
            android:id="@+id/btnTemperature"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ler temperatura simulada" />

        <Button
            android:id="@+id/btnObserveCpu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Iniciar Observe da CPU" />

        <TextView
            android:id="@+id/tvObserveOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="Observe CPU: parado" />

        <View
            android:layout_width="match_parent"
            android:layout_height="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Atuadores"
            android:textStyle="bold"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/etActuatorMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Digite uma mensagem"
            android:text="Olá do Raspberry com Android!" />

        <Button
            android:id="@+id/btnSendMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mostrar mensagem na tela do PC" />

        <Button
            android:id="@+id/btnWriteLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enviar mensagem para log" />

        <View
            android:layout_width="match_parent"
            android:layout_height="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Saída"
            android:textStyle="bold"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#EEEEEE"
            android:minHeight="220dp"
            android:padding="12dp"
            android:text="Aguardando ações..." />
    </LinearLayout>
</ScrollView>