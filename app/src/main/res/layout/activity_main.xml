<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/server_title"
            android:textStyle="bold"
            android:textSize="20sp" />

        <EditText
            android:id="@+id/etServerHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/host_hint"
            android:text="@string/default_host" />

        <Button
            android:id="@+id/btnDiscover"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_discover" />

        <View
            android:layout_width="match_parent"
            android:layout_height="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sensors_title"
            android:textStyle="bold"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnCpu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_cpu" />

        <Button
            android:id="@+id/btnMemory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_memory" />

        <Button
            android:id="@+id/btnDisk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_disk" />

        <Button
            android:id="@+id/btnTemperature"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_temp" />

        <Button
            android:id="@+id/btnObserveCpu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_observe" />

        <TextView
            android:id="@+id/tvObserveOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="@string/observe_stopped" />

        <View
            android:layout_width="match_parent"
            android:layout_height="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/actuators_title"
            android:textStyle="bold"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/etActuatorMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/message_hint"
            android:text="@string/default_message" />

        <Button
            android:id="@+id/btnSendMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_send_message" />

        <Button
            android:id="@+id/btnWriteLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_write_log" />

        <View
            android:layout_width="match_parent"
            android:layout_height="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/output_title"
            android:textStyle="bold"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#EEEEEE"
            android:minHeight="220dp"
            android:padding="12dp"
            android:text="@string/waiting_actions" />
    </LinearLayout>
</ScrollView>